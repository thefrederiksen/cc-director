<Window x:Class="CcDirectorSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevThrottle Setup"
        Icon="app.ico"
        Width="900" Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBackground}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <DockPanel Margin="20">
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,32">
                    <TextBlock Text="DevThrottle"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Setup"
                               Foreground="{StaticResource DimText}"
                               FontSize="16"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Version at bottom (set at runtime from the assembly stamp, see ctor) -->
                <TextBlock x:Name="VersionText"
                           DockPanel.Dock="Bottom"
                           Text=""
                           Foreground="{StaticResource MutedText}"
                           FontSize="11"
                           Margin="0,0,0,4" />

                <!-- Step indicators. One linear Director-only path (issue #1807): Welcome,
                     Prerequisites, Privacy, Skills, Install, Complete. The old Sign-in and Connect
                     rows (the account/gateway gate) are gone. The circle numbers are renumbered 1..6
                     at runtime by UpdateSidebar; the x:Names keep their historical step ids (1, 2, 4,
                     6, 7, 8) so MainWindow's step switch and the WizardStepFlow ids stay unchanged. -->
                <StackPanel x:Name="StepIndicators" VerticalAlignment="Top">
                    <!-- Step 1: Welcome -->
                    <StackPanel x:Name="Step1Row" Orientation="Horizontal">
                        <Border x:Name="Step1Circle" Width="28" Height="28" CornerRadius="14"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock Text="1" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Step1Label" Text="Welcome"
                                   Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Line 1-2 -->
                    <Border Width="2" Height="24" Margin="13,0,0,0"
                            HorizontalAlignment="Left"
                            Background="{StaticResource StepInactive}"
                            x:Name="Line12" />

                    <!-- Step 2: Prerequisites -->
                    <StackPanel x:Name="Step2Row" Orientation="Horizontal">
                        <Border x:Name="Step2Circle" Width="28" Height="28" CornerRadius="14"
                                Background="{StaticResource StepInactive}">
                            <TextBlock Text="2" Foreground="{StaticResource DimText}" FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       x:Name="Step2Num" />
                        </Border>
                        <TextBlock x:Name="Step2Label" Text="Prerequisites"
                                   Foreground="{StaticResource DimText}" FontSize="13"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Line 2-4 (step 3, Sign in, was removed with the account gate) -->
                    <Border Width="2" Height="24" Margin="13,0,0,0"
                            HorizontalAlignment="Left"
                            Background="{StaticResource StepInactive}"
                            x:Name="Line23" />

                    <!-- Step 4 (shown 3rd): Privacy (telemetry consent, issue #659) -->
                    <StackPanel x:Name="Step4Row" Orientation="Horizontal">
                        <Border x:Name="Step4Circle" Width="28" Height="28" CornerRadius="14"
                                Background="{StaticResource StepInactive}">
                            <TextBlock Text="3" Foreground="{StaticResource DimText}" FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       x:Name="Step4Num" />
                        </Border>
                        <TextBlock x:Name="Step4Label" Text="Privacy"
                                   Foreground="{StaticResource DimText}" FontSize="13"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Line 4-6 (step 5, Connect, was removed with the account gate) -->
                    <Border Width="2" Height="24" Margin="13,0,0,0"
                            HorizontalAlignment="Left"
                            Background="{StaticResource StepInactive}"
                            x:Name="Line45" />

                    <!-- Step 6 (shown 4th): Skills -->
                    <StackPanel x:Name="Step6Row" Orientation="Horizontal">
                        <Border x:Name="Step6Circle" Width="28" Height="28" CornerRadius="14"
                                Background="{StaticResource StepInactive}">
                            <TextBlock Text="4" Foreground="{StaticResource DimText}" FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       x:Name="Step6Num" />
                        </Border>
                        <TextBlock x:Name="Step6Label" Text="Skills"
                                   Foreground="{StaticResource DimText}" FontSize="13"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Line 6-7 -->
                    <Border Width="2" Height="24" Margin="13,0,0,0"
                            HorizontalAlignment="Left"
                            Background="{StaticResource StepInactive}"
                            x:Name="Line67" />

                    <!-- Step 7 (shown 5th): Install -->
                    <StackPanel x:Name="Step7Row" Orientation="Horizontal">
                        <Border x:Name="Step7Circle" Width="28" Height="28" CornerRadius="14"
                                Background="{StaticResource StepInactive}">
                            <TextBlock Text="5" Foreground="{StaticResource DimText}" FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       x:Name="Step7Num" />
                        </Border>
                        <TextBlock x:Name="Step7Label" Text="Install"
                                   Foreground="{StaticResource DimText}" FontSize="13"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Line 7-8 -->
                    <Border Width="2" Height="24" Margin="13,0,0,0"
                            HorizontalAlignment="Left"
                            Background="{StaticResource StepInactive}"
                            x:Name="Line78" />

                    <!-- Step 8 (shown 6th): Complete -->
                    <StackPanel x:Name="Step8Row" Orientation="Horizontal">
                        <Border x:Name="Step8Circle" Width="28" Height="28" CornerRadius="14"
                                Background="{StaticResource StepInactive}">
                            <TextBlock Text="6" Foreground="{StaticResource DimText}" FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       x:Name="Step8Num" />
                        </Border>
                        <TextBlock x:Name="Step8Label" Text="Complete"
                                   Foreground="{StaticResource DimText}" FontSize="13"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Content Area -->
        <DockPanel Grid.Column="1" Margin="0">
            <!-- Bottom navigation bar -->
            <Border x:Name="NavBar" DockPanel.Dock="Bottom" Background="{StaticResource SidebarBackground}"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back"
                            Width="90" Click="BackButton_Click"
                            Visibility="Collapsed" />
                    <Button x:Name="NextButton" Content="Next"
                            Width="90" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="NextButton_Click" />
                </StackPanel>
            </Border>

            <!-- Step content -->
            <ContentControl x:Name="StepContent" Margin="32,24" />
        </DockPanel>
    </Grid>
</Window>
