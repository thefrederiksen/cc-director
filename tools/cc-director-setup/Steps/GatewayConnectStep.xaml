<UserControl x:Class="CcDirectorSetup.Steps.GatewayConnectStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Connect to your gateway"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="This machine joins an existing fleet, so it must connect to your gateway before we finish. Sign in with the same DevThrottle account your gateway uses - we find your gateway for you, so there is no address to type."
                       Foreground="{StaticResource TextForeground}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- Centered join card -->
        <Border Background="#252526"
                CornerRadius="6"
                Padding="32"
                Margin="0,28,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                MinWidth="440">
            <StackPanel>

                <!-- Sign in: the browser opens for you to sign in to your DevThrottle account; on success we
                     read your account's gateways and connect this machine automatically. No address to type. -->
                <Button x:Name="SignInButton"
                        Content="Sign in to DevThrottle"
                        Width="220"
                        Height="40"
                        FontSize="15"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButton}"
                        Click="SignInButton_Click" />
                <TextBlock Text="Your web browser opens to sign in. Use the same account your gateway is signed in to."
                           Foreground="{StaticResource DimText}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <!-- Gateway chooser (issue #1206): shown only when the account has more than one gateway.
                     Gateways are listed by NAME - a raw URL is never shown. -->
                <StackPanel x:Name="ChooserPanel"
                            Margin="0,18,0,0"
                            Visibility="Collapsed">
                    <TextBlock Text="Choose your gateway"
                               Foreground="{StaticResource TextForeground}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Your account has more than one gateway. Pick the one this machine should join."
                               Foreground="{StaticResource DimText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <ListBox x:Name="GatewayList"
                             Margin="0,8,0,0"
                             MaxHeight="150"
                             Background="#1E1E1E"
                             Foreground="#CCCCCC"
                             BorderBrush="#3C3C3C"
                             BorderThickness="1"
                             DisplayMemberPath="Name"
                             SelectionChanged="GatewayList_SelectionChanged" />
                    <Button x:Name="ChooseConnectButton"
                            Content="Connect to selected gateway"
                            Width="260"
                            Height="36"
                            FontSize="14"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButton}"
                            Click="ChooseConnectButton_Click" />

                </StackPanel>

                <!-- Waiting state: the browser is open for sign-in (or the connect is in flight); Cancel
                     unwinds a sign-in wait. -->
                <StackPanel x:Name="WaitingPanel"
                            Orientation="Horizontal"
                            Margin="0,18,0,0"
                            Visibility="Collapsed">
                    <TextBlock x:Name="WaitingText"
                               Text="Waiting for you to sign in in your browser..."
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Height="28"
                            FontSize="12"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Click="CancelButton_Click" />
                </StackPanel>

                <!-- Status message (error / blocked reason) -->
                <TextBlock x:Name="StatusText"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="#E05656"
                           Margin="0,18,0,0"
                           Visibility="Collapsed" />

                <!-- Success banner -->
                <StackPanel x:Name="SuccessPanel"
                            Orientation="Horizontal"
                            Margin="0,18,0,0"
                            Visibility="Collapsed">
                    <Border Width="28" Height="28" CornerRadius="14"
                            Background="{StaticResource SuccessBrush}"
                            Margin="0,0,10,0">
                        <TextBlock Text="OK"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="SuccessText"
                               Text="Connected. Click Next to continue."
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
