<UserControl x:Class="CcDirectorSetup.Steps.InstallStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText"
                       Text="Installing"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <!-- The status line WRAPS. It used to be a horizontal StackPanel, which gives its children
                 infinite width and then clips them at the window edge, so the launcher failure read
                 "...did not answer on 7900. Check C:" - cut off exactly where the log path, the only
                 actionable part of the sentence, began (issue #1152). A Grid with a starred column
                 gives the text the width it actually has, and it wraps instead of disappearing. -->
            <Grid Margin="0,8,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Preparing..."
                           Foreground="{StaticResource TextForeground}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button x:Name="RepairButton"
                        Grid.Column="1"
                        Content="Repair"
                        Width="90" Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButton}"
                        Click="RepairButton_Click"
                        Visibility="Collapsed" />
            </Grid>
        </StackPanel>

        <!-- Log location + report (visible DURING install, so a stuck/hung run can still be reported). -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="LogFooter"
                       Foreground="#666666"
                       FontSize="11"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="OpenLogButton" Content="Open log folder" Padding="10,3"
                        Margin="0,0,8,0" Click="OpenLogButton_Click" />
                <Button x:Name="ReportButton" Content="Stuck or failing? Report on GitHub" Padding="10,3"
                        Click="ReportButton_Click" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- The application is the Director. That is what it is called everywhere else in the
                     product; DevThrottle is the product, and cc-director.exe is just the file name. -->
                <Border Background="#2A2D2E" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Director"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Main application"
                                       Foreground="#888888"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                            <ProgressBar x:Name="DirectorProgress"
                                         Height="3" Margin="0,8,24,0"
                                         Background="#3C3C3C" Foreground="#007ACC"
                                         BorderThickness="0"
                                         Visibility="Collapsed" />
                            <!-- The failure REASON, when there is one. The engine always computed it and
                                 nothing ever showed it, so "Failed" sent the user to a log file. -->
                            <TextBlock x:Name="DirectorDetail"
                                       Foreground="#F0A030"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,12,0"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock x:Name="DirectorSize"
                                       Foreground="#888888" FontSize="11"
                                       HorizontalAlignment="Right" />
                            <TextBlock x:Name="DirectorStatus"
                                       Text="Pending"
                                       Foreground="#CCCCCC"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- cc-launcher: the always-on tray app this installer places and starts. It used to be
                     invisible here (its work was reported under a "Gateway & Cockpit" card, which named
                     two things this installer does not install), so a launcher that failed to start was
                     counted on the Complete screen without ever having appeared on a screen. -->
                <Border Background="#2A2D2E" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Launcher"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Keeps the Director available in the background"
                                       Foreground="#888888"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                            <ProgressBar x:Name="LauncherProgress"
                                         Height="3" Margin="0,8,24,0"
                                         Background="#3C3C3C" Foreground="#007ACC"
                                         BorderThickness="0"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />
                            <!-- The failure REASON, when there is one. The engine always computed it and
                                 nothing ever showed it, so "Failed" sent the user to a log file. -->
                            <TextBlock x:Name="LauncherDetail"
                                       Foreground="#F0A030"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,12,0"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <TextBlock x:Name="LauncherStatus"
                                   Grid.Column="1"
                                   Text="Pending"
                                   Foreground="#CCCCCC"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Tools section: the cc-* command-line tools are provisioned by the app on first launch,
                     not by the installer (that kept the install snappy). This is an honest note, not a
                     live install row. -->
                <Border Background="#2A2D2E" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tools"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Your cc-* command-line tools finish setting up the first time you open the Director."
                                       Foreground="#888888"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Every other row carries a status, so a blank one here read as a row
                             that had not finished. It is not pending - it is deliberately deferred,
                             and saying so is the honest status. -->
                        <TextBlock Grid.Column="1"
                                   Text="Sets up on first launch"
                                   Foreground="#CCCCCC"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
