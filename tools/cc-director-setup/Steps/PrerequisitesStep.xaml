<UserControl x:Class="CcDirectorSetup.Steps.PrerequisitesStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Prerequisites"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <!-- This line carries the failure message, which is the recovery instruction. It MUST
                 wrap: unwrapped it was cut in half at the window edge, so the half telling the user
                 what to do next was the half that disappeared. -->
            <TextBlock x:Name="SubtitleText"
                       Text="Checking required software..."
                       Foreground="{StaticResource TextForeground}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16" />
        </StackPanel>

        <!-- Success banner (hidden by default) -->
        <Border x:Name="SuccessBanner"
                DockPanel.Dock="Bottom"
                Background="#1B3A2A"
                CornerRadius="6"
                Padding="16"
                Margin="0,16,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="16"
                        Background="#22C55E"
                        Margin="0,0,12,0">
                    <TextBlock Text="OK"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="All prerequisites met -- ready to install."
                           Foreground="#22C55E"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Button x:Name="RefreshButton" Content="Re-check"
                DockPanel.Dock="Bottom"
                HorizontalAlignment="Left"
                Width="100"
                Margin="0,12,0,0"
                Click="RefreshButton_Click" />

        <!-- The card list scrolls; everything else on this screen is pinned.
             The DockPanel gives its LAST child whatever space the docked items leave, so the
             Re-check button and the success banner (docked Bottom above) hold their place and the
             list takes the rest. Without this the list simply ran off the bottom of the window
             with no scrollbar: once the descriptions were allowed to wrap onto a second line the
             cards grew, and the fourth card's "Install automatically" button was cut in half -
             the user could see the action but not reach it. -->
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PrereqList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2A2D2E"
                            CornerRadius="4"
                            Padding="14,10"
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- The status column is FIXED. On Auto it took whatever width its
                                     longest word wanted and the descriptions lost the difference,
                                     which is why they were cut off mid-sentence ("so you can
                                     install this late", "bring their own Python and ("). -->
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <Border CornerRadius="3"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            Background="#3A1B1B"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Required"
                                                   Foreground="#CC4444"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Border CornerRadius="3"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            Background="#2A2A2A"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRequired}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ImportanceLabel}"
                                                   Foreground="#888888"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Description}"
                                           Foreground="#888888"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />

                                <TextBlock Text="{Binding Version}"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Version}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Install link (shown when not found) -->
                                <TextBlock Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Hyperlink NavigateUri="{Binding InstallUrl}"
                                               RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextDecorations="None">
                                        <Run Text="Download and install ->" />
                                    </Hyperlink>
                                </TextBlock>

                                <!-- Auto-install via winget (shown when supported and missing) -->
                                <Button Content="Install automatically"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"
                                        Padding="10,4"
                                        Click="InstallButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowAutoInstall}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Status}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#888888" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFound}" Value="True">
                                                <Setter Property="Foreground" Value="#22C55E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
