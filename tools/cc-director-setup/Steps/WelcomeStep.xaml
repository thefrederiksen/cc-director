<UserControl x:Class="CcDirectorSetup.Steps.WelcomeStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Image x:Name="AppIcon"
                   Source="pack://application:,,,/app.ico"
                   Width="48"
                   Height="48"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <TextBlock x:Name="TitleText"
                       Text="Welcome to DevThrottle"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Run every coding agent in parallel, on Windows"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />

            <!-- Fresh install: what the installer lays down. No account, no gateway, no role choice
                 (issue #1807). The update path overwrites this text with the "Checking for updates /
                 Up to date / Upgrade available" line.

                 This copy matches the website. It used to sell "a Windows-first toolkit for Claude
                 Code developers", so someone who bought the multi-agent story on the website had
                 good reason to doubt they had downloaded the right thing. -->
            <TextBlock x:Name="DescriptionText"
                       Text="DevThrottle runs Claude Code, Codex, Gemini and other coding agents side by side on one board, so you can keep several going at once. It tells you the moment one of them needs you. No account is needed to install it."
                       Foreground="{StaticResource TextForeground}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="40,16,40,0"
                       LineHeight="20" />

            <TextBlock x:Name="VersionInfoText"
                       Foreground="{StaticResource DimText}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"
                       Visibility="Collapsed" />

            <!-- ============================ UPDATE MODE: read-only role ============================ -->
            <!-- Role is a first-install choice the update wizard does not re-ask, so instead of an
                 interactive picker we show, read-only, which type this machine was installed as.
                 Detected from disk by InstalledRoleDetector and passed in by MainWindow. A fresh
                 install makes no role choice at all (issue #1807). -->
            <Border x:Name="InstalledRolePanel"
                    Margin="40,24,40,0"
                    Padding="16,12"
                    Background="#1A000000"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Install type"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="InstalledRoleText"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextForeground}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ClickNextHint"
                       Text="Click Next to continue."
                       Foreground="{StaticResource DimText}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0" />

            <!-- Uninstall entry (issue #257): shown only when an existing install is detected
                 (update mode). Removes the app, tools, PATH, scheduled tasks, and the
                 Gateway autostart + Tailscale mapping; the user's data is preserved. -->
            <Button x:Name="UninstallButton"
                    Content="Uninstall DevThrottle"
                    Style="{StaticResource DangerButton}"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    Visibility="Collapsed"
                    Click="UninstallButton_Click" />

            <TextBlock x:Name="UninstallHint"
                       Text="Removes the app, tools, and integration. Your data (config, vault, sign-ins) is kept."
                       Foreground="{StaticResource DimText}"
                       FontSize="11"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="40,8,40,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
