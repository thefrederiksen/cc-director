<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CcDirectorSetup.Steps.GatewayConnectStep">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Connect to your Gateway"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <TextBlock Text="Connecting this machine to your DevThrottle Gateway lets you see and control it from your other machines and your phone. Sign in with your DevThrottle account and the gateway is found automatically."
                       Foreground="#CCCCCC"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       LineHeight="20" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="You can skip this step and connect later from inside DevThrottle."
                   Foreground="#888888"
                   FontSize="12"
                   Margin="0,8,0,0" />

        <ScrollViewer Margin="0,20,0,0">
            <StackPanel Spacing="12">

                <!-- Already connected (an update / repair run) -->
                <StackPanel x:Name="AlreadyConnectedPanel" IsVisible="False" Spacing="6">
                    <TextBlock x:Name="AlreadyConnectedText"
                               Foreground="#22C55E"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Nothing to do here - click Next to continue."
                               Foreground="#CCCCCC"
                               FontSize="13" />
                </StackPanel>

                <!-- Primary action: sign in and auto-discover -->
                <StackPanel x:Name="ActionPanel" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SignInButton"
                            Classes="primary"
                            Content="Sign in to DevThrottle"
                            Click="SignInButton_Click" />
                    <Button x:Name="ManualToggleButton"
                            Classes="setup"
                            Content="Enter the address manually"
                            Click="ManualToggleButton_Click" />
                </StackPanel>

                <!-- Waiting state -->
                <StackPanel x:Name="WaitingPanel" IsVisible="False" Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="WaitingText"
                               Foreground="#CCCCCC"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <Button x:Name="CancelButton"
                            Classes="setup"
                            Content="Cancel"
                            Click="CancelButton_Click" />
                </StackPanel>

                <!-- Gateway chooser (more than one gateway on the account) -->
                <StackPanel x:Name="ChooserPanel" IsVisible="False" Spacing="8">
                    <TextBlock Text="Your account has more than one gateway. Choose the one this machine belongs to:"
                               Foreground="#CCCCCC"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <!-- The chooser shows gateway NAMES only - a raw address is never shown. -->
                    <ListBox x:Name="GatewayList"
                             Background="#252526"
                             Foreground="White"
                             MaxHeight="160">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="ChooseConnectButton"
                            Classes="primary"
                            Content="Connect"
                            Click="ChooseConnectButton_Click" />
                </StackPanel>

                <!-- Manual entry with a mandatory reachability test -->
                <StackPanel x:Name="ManualPanel" IsVisible="False" Spacing="8">
                    <TextBlock x:Name="ManualNoteText"
                               Text="Enter the gateway machine's computer name (or a full address) and port."
                               Foreground="#CCCCCC"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="AddressBox"
                                 Width="320"
                                 Watermark="computer name or http://address"
                                 TextChanged="ManualField_TextChanged" />
                        <TextBox x:Name="PortBox"
                                 Width="90"
                                 Text="7878"
                                 Watermark="port"
                                 TextChanged="ManualField_TextChanged" />
                        <Button x:Name="TestButton"
                                Classes="setup"
                                Content="Test"
                                Click="TestButton_Click" />
                        <Button x:Name="ManualConnectButton"
                                Classes="primary"
                                Content="Connect"
                                IsEnabled="False"
                                Click="ManualConnectButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TestResultText"
                               Foreground="#888888"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Outcome -->
                <TextBlock x:Name="StatusText"
                           IsVisible="False"
                           Foreground="#CCCCCC"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
