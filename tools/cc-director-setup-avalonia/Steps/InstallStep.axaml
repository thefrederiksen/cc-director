<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CcDirectorSetup.Steps.InstallStep">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText"
                       Text="Installing"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,20">
                <TextBlock x:Name="StatusText"
                           Text="Preparing..."
                           Foreground="#CCCCCC"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <Button x:Name="RepairButton"
                        Content="Repair"
                        Classes="primary"
                        Width="90" Margin="16,0,0,0"
                        Click="RepairButton_Click"
                        IsVisible="False" />
            </StackPanel>
        </StackPanel>

        <!-- Log location + report (visible DURING install, so a stuck/hung run can still be reported). -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="LogFooter"
                       Foreground="#666666"
                       FontSize="11"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="OpenLogButton" Classes="setup" Content="Open log folder" Padding="10,3"
                        Margin="0,0,8,0" Click="OpenLogButton_Click" />
                <Button x:Name="ReportButton" Classes="setup" Content="Stuck or failing? Report on GitHub" Padding="10,3"
                        Click="ReportButton_Click" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer>
            <StackPanel>
                <!-- The main app. Called DevThrottle here, which is what the user downloaded and what
                     every other screen calls it - cc-director is the name of the executable. -->
                <Border Background="#2A2D2E" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DevThrottle"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Main application"
                                       Foreground="#888888"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                            <ProgressBar x:Name="DirectorProgress"
                                         Height="3" Margin="0,8,24,0"
                                         Background="#3C3C3C" Foreground="#007ACC"
                                         IsVisible="False"
                                         Minimum="0" Maximum="100" />
                            <!-- The failure REASON, when there is one. The engine always computed it and
                                 nothing ever showed it, so "Failed" sent the user to a log file. -->
                            <TextBlock x:Name="DirectorDetail"
                                       Foreground="#F0A030"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,12,0"
                                       IsVisible="False" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock x:Name="DirectorSize"
                                       Foreground="#888888" FontSize="11"
                                       HorizontalAlignment="Right" />
                            <TextBlock x:Name="DirectorStatus"
                                       Text="Pending"
                                       Foreground="#CCCCCC"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- cc-launcher: the always-on launcher tray. Always shown, on both platforms - without
                     this row the launcher installed (or failed) INVISIBLY, and the Complete step could
                     report "1 component did not install" for a component no screen had ever shown. -->
                <Border x:Name="LauncherCard" Background="#2A2D2E" CornerRadius="6" Padding="16"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="cc-launcher"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Keeps DevThrottle available in the background"
                                       Foreground="#888888"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                            <ProgressBar x:Name="LauncherProgress"
                                         Height="3" Margin="0,8,24,0"
                                         Background="#3C3C3C" Foreground="#007ACC"
                                         IsVisible="False"
                                         Minimum="0" Maximum="100" />
                            <!-- The failure REASON, when there is one. The engine always computed it and
                                 nothing ever showed it, so "Failed" sent the user to a log file. -->
                            <TextBlock x:Name="LauncherDetail"
                                       Foreground="#F0A030"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,12,0"
                                       IsVisible="False" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock x:Name="LauncherSize"
                                       Foreground="#888888" FontSize="11"
                                       HorizontalAlignment="Right" />
                            <TextBlock x:Name="LauncherStatus"
                                       Text="Pending"
                                       Foreground="#CCCCCC"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tools section: the cc-* command-line tools are provisioned by the app on first launch,
                     not by the installer (that kept the install snappy). This is an honest note, not a
                     live install row. -->
                <Border Background="#2A2D2E" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tools"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Your cc-* command-line tools finish setting up the first time you open DevThrottle."
                                       Foreground="#888888"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Every other row carries a status, so a blank one here read as a row that had
                             not finished. It is not pending - it is deliberately deferred, and saying so
                             is the honest status. -->
                        <TextBlock Grid.Column="1"
                                   Text="Sets up on first launch"
                                   Foreground="#CCCCCC"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
