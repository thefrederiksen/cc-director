<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CcDirectorSetup.Steps.WelcomeStep">
    <!-- Mirrors the Windows wizard's WelcomeStep (the master, issue #1807): a fresh install makes
         NO decision on this screen - no profile, no role, no account. The update path shows the
         installed version and, read-only, which install type this machine is. -->
    <ScrollViewer>
        <StackPanel>
            <Image Source="avares://cc-director-setup/Assets/AppIcon.png"
                   Width="64"
                   Height="64"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

            <TextBlock x:Name="TitleText"
                       Text="Welcome to DevThrottle"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="A toolkit for Claude Code developers"
                       Foreground="#007ACC"
                       FontSize="13"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />

            <!-- Fresh install: what the installer lays down. No account, no gateway, no role choice
                 (issue #1807). The update path overwrites this text with the "Checking for updates /
                 Up to date / Upgrade available" line. -->
            <TextBlock x:Name="DescriptionText"
                       Text="DevThrottle runs and manages multiple Claude Code sessions side by side, with a full suite of CLI tools for documents, browser automation, email, media, and more. No account is needed to install it."
                       Foreground="#CCCCCC"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="40,16,40,0"
                       LineHeight="20" />

            <TextBlock x:Name="VersionInfoText"
                       Foreground="#888888"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"
                       IsVisible="False" />

            <!-- ============================ UPDATE MODE: read-only role ============================ -->
            <!-- Role is a first-install choice the update wizard does not re-ask, so instead of an
                 interactive picker we show, read-only, which type this machine was installed as.
                 Detected from disk by InstalledRoleDetector and passed in by MainWindow. A fresh
                 install makes no role choice at all (issue #1807). -->
            <Border x:Name="InstalledRolePanel"
                    Margin="40,24,40,0"
                    Padding="16,12"
                    Background="#2A2D2E"
                    CornerRadius="6"
                    IsVisible="False">
                <StackPanel>
                    <TextBlock Text="Install type"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="InstalledRoleText"
                               TextWrapping="Wrap"
                               Foreground="#CCCCCC"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ClickNextHint"
                       Text="Click Next to continue."
                       Foreground="#888888"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0" />

            <!-- Uninstall entry (issue #257): shown only when an existing install is detected
                 (update mode). Removes the app, tools, PATH, and the launch agent; the
                 user's data is preserved. -->
            <Button x:Name="UninstallButton"
                    Content="Uninstall DevThrottle"
                    Classes="danger"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    IsVisible="False"
                    Click="UninstallButton_Click" />

            <TextBlock x:Name="UninstallHint"
                       Text="Removes the app, tools, and integration. Your data (config, vault, sign-ins) is kept."
                       Foreground="#888888"
                       FontSize="11"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="40,8,40,0"
                       IsVisible="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
