<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CcDirector.Setup.Engine</AssemblyName>
    <RootNamespace>CcDirector.Setup.Engine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internals (e.g. ProcessRunner) to the engine test project for direct unit testing. -->
    <InternalsVisibleTo Include="CcDirector.Setup.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Workstation gateway-join gate (issues #646, #1198) reuses the account sign-in + device
         enrollment already built in Core (LoopbackLoginListener, DeviceRegistryClient) and the
         /m/enroll contract (Gateway.Contracts), persisting the issued local device key via
         GatewayCredentialStore (Core) - no new pairing mechanism and no new cloud endpoint. -->
    <ProjectReference Include="..\..\src\CcDirector.Core\CcDirector.Core.csproj" />
    <ProjectReference Include="..\..\src\CcDirector.Gateway.Contracts\CcDirector.Gateway.Contracts.csproj" />
  </ItemGroup>

</Project>
