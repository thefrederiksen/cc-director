<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The library side of the Your Throttle conformance check (mission "Clean up Your Throttle", phase
    three). This runs the Gateway's OWN ThrottleDefinition and ThrottleLedgerReader - the code behind
    GET /stats/data - against a Gateway database from outside the Gateway, and prints the figure as JSON.
    conformance.py compares that JSON with the mentor harness's own reading of the same ledger and fails
    when the two consumers diverge. Read-only: it never opens the database through GatewayDatabase, whose
    Open() checks for and applies pending migrations.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>throttle-conformance</AssemblyName>
    <RootNamespace>ThrottleConformance</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CcDirector.Gateway\CcDirector.Gateway.csproj" />
  </ItemGroup>

</Project>
