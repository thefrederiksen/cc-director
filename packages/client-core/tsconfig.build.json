{
  // The library's own standalone build: emit declaration files to dist/ so `npm run build` proves the
  // package compiles on its own (Issue #968 acceptance criterion 1). The shells consume the package
  // as TypeScript source (see the "exports" map in package.json), so no JavaScript emit is needed -
  // and `moduleResolution: bundler` only permits declaration-only emit anyway.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  // The unit tests are type-checked by `npm run typecheck` (tsconfig.json includes them) but are not
  // part of the shipped library, so they are excluded from the declaration build.
  "exclude": ["**/*.test.ts"]
}
