<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <!-- G8 tenant-isolation architecture gate (TenantGateArchitectureTests): NetArchTest gives the type-graph
         dependency check for DT-TEN-1, and Mono.Cecil (also NetArchTest's own engine) gives the precise
         newobj scan that distinguishes CONSTRUCTING a GatewayDbContext from merely referencing one. -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="Mono.Cecil" Version="0.11.3" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <!-- Issue #1176 (Phase 1a): the SignalR CLIENT (a separate package from the server, which ships in
         the AspNetCore shared framework) so the integration harness can dial the DirectorHub end to end. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <!-- Gateway Cleanup mission: MessagePack so the mechanism-proof test client speaks the same binary
         tunnel protocol the real Director does. 10.0.9 = the patched servicing release. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CcDirector.Core\CcDirector.Core.csproj" />
    <ProjectReference Include="..\CcDirector.ControlApi\CcDirector.ControlApi.csproj" />
    <ProjectReference Include="..\CcDirector.Engine\CcDirector.Engine.csproj" />
    <ProjectReference Include="..\CcDirector.Gateway.Contracts\CcDirector.Gateway.Contracts.csproj" />
    <ProjectReference Include="..\CcDirector.Gateway\CcDirector.Gateway.csproj" />
    <!-- Hosted Gateway mission, Step 4a: the Postgres migration assembly, so the real-Postgres proof test
         (PostgresProviderProofTests) can load it and Database.Migrate() applies the Postgres migration set.
         This is the same runtime dependency the hosted Gateway host will carry; here it lets the test prove
         the provider-agnostic model runs on real Postgres. The test is gated behind an env var, so this
         reference does not change the default (SQLite) test run. -->
    <ProjectReference Include="..\CcDirector.Gateway.Migrations.Postgres\CcDirector.Gateway.Migrations.Postgres.csproj" />
    <!-- The no-SQLite-on-hosted guard (NoSqliteOnHostedArchitectureTests, DT-SQL-1) scans the assemblies that
         ARE the hosted Gateway service, and the container entry point is one of them. Referenced so its DLL
         lands in the test output where the metadata scan can read it; a missing assembly is a red test rather
         than a quietly smaller scan, so this reference is load-bearing. Nothing in the test code calls into
         it, so do NOT remove it as an unused reference. -->
    <ProjectReference Include="..\CcDirector.Gateway.Host\CcDirector.Gateway.Host.csproj" />
  </ItemGroup>

  <!-- The reference above drags the host project's CONTENT across too, and one of those files is
       hosted-gateway.image - the IMMUTABLE marker that means "this deployment is the hosted container".
       GatewayHostedMode.IsHostedImage looks for it in the application base directory, which for a test run
       is this output directory, so its presence makes EVERY test in this assembly believe it is hosted.
       That is not a cosmetic problem: it silently inverts the self-host arm of every test that contrasts
       the two deployments, and such a test then passes or fails for a reason that has nothing to do with
       what it is checking.

       The guard needs the host's DLL, not its content. Remove the marker from the test output after the
       copy, so the assembly the metadata scan reads is present and the deployment identity this process
       reports is the truthful one: these tests are not a hosted container. -->
  <Target Name="RemoveHostedImageMarkerFromTestOutput" AfterTargets="Build">
    <Delete Files="$(OutputPath)hosted-gateway.image" />
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
