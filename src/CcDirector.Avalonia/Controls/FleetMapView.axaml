<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CcDirector.Avalonia.Controls.FleetMapView"
             Background="#1E1E1E">

    <UserControl.Styles>
        <!-- A card is a Button (for keyboard + accessibility), but it must READ as a card: no button
             chrome, content left-aligned, and a hover that lifts rather than repaints. -->
        <Style Selector="Button.fleetCard">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.fleetCard:pointerover">
            <Setter Property="Background" Value="#2D2D30" />
        </Style>
        <Style Selector="Button.fleetCard:focus">
            <Setter Property="BorderBrush" Value="#007ACC" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Header: pivot switch + fleet tally -->
        <DockPanel DockPanel.Dock="Top" Margin="24,20,24,12">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="BtnPivotRepo" Content="By repository"
                        Click="BtnPivotRepo_Click"
                        Padding="12,4" FontSize="12"
                        BorderThickness="0" Cursor="Hand" />
                <Button x:Name="BtnPivotAgent" Content="By agent"
                        Click="BtnPivotAgent_Click"
                        Padding="12,4" FontSize="12"
                        BorderThickness="0" Cursor="Hand" />
            </StackPanel>
            <TextBlock x:Name="StatsText"
                       Text="Loading..."
                       Foreground="#888888"
                       FontSize="12"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Not-connected / error state. Never silently empty: an empty fleet and an unreachable
             Gateway must not look the same. -->
        <TextBlock x:Name="MessageText"
                   Text=""
                   Foreground="#EAB308" FontSize="12"
                   TextWrapping="Wrap"
                   Margin="24,0,24,12"
                   DockPanel.Dock="Top"
                   IsVisible="False" />

        <ScrollViewer x:Name="MapScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Visible">
            <ItemsControl x:Name="LanesList" Margin="24,0,24,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <!-- Lane header -->
                            <Border Background="#252526"
                                    BorderBrush="#3C3C3C" BorderThickness="0,0,0,1"
                                    Padding="10,6">
                                <DockPanel>
                                    <TextBlock Text="{Binding CountDisplay}"
                                               DockPanel.Dock="Right"
                                               Foreground="#888888" FontSize="11"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#CCCCCC"
                                               FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- Cards, already in spawn-tree order -->
                            <ItemsControl ItemsSource="{Binding Nodes}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A Button, not a Border with a PointerPressed handler. A card IS a
                                             button: it must be reachable by keyboard, and it must expose an
                                             Invoke pattern to the accessibility tree - which a bare Border
                                             does not. (It is also what lets the card be driven by UI
                                             Automation, which is how this view is proved.) -->
                                        <Button Classes="fleetCard"
                                                Margin="{Binding IndentMargin}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="#252526"
                                                BorderBrush="{Binding BorderBrushForCard}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="9,7"
                                                Cursor="Hand"
                                                Click="Card_Click"
                                                AutomationProperties.Name="{Binding AutomationName}"
                                                Tag="{Binding}">
                                            <StackPanel Spacing="4">
                                                <!-- Title row: the title owns the width (issue #1625) -->
                                                <DockPanel>
                                                    <Ellipse Width="9" Height="9"
                                                             DockPanel.Dock="Left"
                                                             Margin="0,3,8,0"
                                                             VerticalAlignment="Top"
                                                             Fill="{Binding DotBrush}" />
                                                    <Border DockPanel.Dock="Left"
                                                            IsVisible="{Binding HasNumber}"
                                                            Background="#3C3C3C"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            Margin="0,0,7,0"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding NumberDisplay}"
                                                                   Foreground="#CCCCCC"
                                                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                                                   FontSize="10" />
                                                    </Border>
                                                    <TextBlock Text="{Binding NameDisplay}"
                                                               Foreground="#E6E6E6"
                                                               FontWeight="SemiBold" FontSize="12.5"
                                                               TextWrapping="Wrap"
                                                               MaxLines="2"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>

                                                <!-- Meta row: role, agent, and where it runs -->
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Border IsVisible="{Binding HasRole}"
                                                            BorderBrush="{Binding RoleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="6,1">
                                                        <TextBlock Text="{Binding RoleDisplay}"
                                                                   Foreground="{Binding RoleBrush}"
                                                                   FontSize="9" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border BorderBrush="#3C3C3C" BorderThickness="1"
                                                            CornerRadius="8" Padding="6,1">
                                                        <TextBlock Text="{Binding AgentDisplay}"
                                                                   Foreground="#888888"
                                                                   FontSize="9" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding LocationDisplay}"
                                                               Foreground="#777777"
                                                               FontFamily="Cascadia Mono,Consolas,monospace"
                                                               FontSize="10"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- State row -->
                                                <DockPanel>
                                                    <TextBlock Text="{Binding OwnershipDisplay}"
                                                               DockPanel.Dock="Right"
                                                               Foreground="#666666"
                                                               FontSize="10"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StateDisplay}"
                                                               Foreground="{Binding DotBrush}"
                                                               FontSize="11" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
