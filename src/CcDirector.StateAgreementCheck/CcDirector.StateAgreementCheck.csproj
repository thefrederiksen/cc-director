<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CcDirector.StateAgreementCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The REAL fold (SessionOrdering) and the REAL wire DTO. This check must NEVER re-implement the
         ladder: a check that re-derives it becomes fold number fifteen - the exact sin this mission
         exists to end, committed by the tool built to prove the sin is gone. It would agree with
         itself and with nothing else. -->
    <ProjectReference Include="..\CcDirector.Gateway.Contracts\CcDirector.Gateway.Contracts.csproj" />
    <!-- The REAL desktop palette (StatusPalette). Same rule: the rendered hex is READ from the shipping
         palette, never re-typed here. -->
    <ProjectReference Include="..\CcDirector.Avalonia\CcDirector.Avalonia.csproj" />
  </ItemGroup>

</Project>
